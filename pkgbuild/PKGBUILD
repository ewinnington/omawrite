# Maintainer: David Heinemeier Hansson <david@hey.com>

pkgname=omaths
pkgver=0.1.0
pkgrel=1
pkgdesc='Markdown writing app for entering LaTeX maths, derived from omawrite'
arch=('x86_64')
url='https://github.com/ewinnington/omaths'
license=('MIT')
install='omaths.install'
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative' 'qt6-svg')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/omaths "$pkgdir/usr/bin/omaths"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  /usr/bin/install -Dm644 "$startdir/omaths.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omaths.svg"
  /usr/bin/install -Dm644 "$startdir/omaths.desktop" "$pkgdir/usr/share/applications/omaths.desktop"
}
